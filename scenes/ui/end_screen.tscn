[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/end_screen.gd" id="1_end"]

[node name="EndScreen" type="CanvasLayer"]
script = ExtResource("1_end")

[node name="Background" type="ColorRect" parent="."]
